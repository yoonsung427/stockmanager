<section data-section="news">
  <h2>News</h2>
  {% for ticker, items in m.news_by_ticker.items() %}
    <h3>{{ ticker }}</h3>
    <ul>
      {% for n in items %}
      <li>
        {{ n.description }} &mdash; {{ n.display_title }}
        {% if n.source_url|safe_url %}
          <a href="{{ n.source_url }}" rel="noopener noreferrer" target="_blank">source</a>
        {% else %}
          <span>{{ n.source_url }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  {% endfor %}
</section>
